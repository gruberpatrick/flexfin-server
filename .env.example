# Copy to .env and edit. server.py loads .env on startup; real environment
# variables take precedence over anything set here. .env is gitignored.

# --- required ---------------------------------------------------------------

# Jellyfin base URL. Used to verify logins and to read the merged library.
# Unset means every login is refused.
JELLYFIN_URL=http://your-jellyfin:8096

# --- merge / Jellyfin library --------------------------------------------------

# Base URL the *client* uses to fetch audio and images for local items.
# Defaults to JELLYFIN_URL - leave this unset unless clients are NOT on the
# Jellyfin LAN and need a different, publicly reachable host. Must start with
# http:// or https:// (a whole URL, not a prefix to add to JELLYFIN_URL).
#JELLYFIN_PUBLIC_URL=http://192.168.1.78:30013

# "false" serves Tidal only, ignoring the Jellyfin library (pre-merge behaviour).
#MERGE_LOCAL_LIBRARY=true

# Testing aid: prefix every item name with "[J] " (real Jellyfin library) or
# "[T] " (Tidal) so it is obvious in any client what the merge pulled from where.
#MERGE_TAG_SOURCE=false

# Seconds to wait for a Jellyfin library call before falling back to Tidal-only.
#JELLYFIN_API_TIMEOUT=10

# Seconds to wait for Jellyfin during a login.
#JELLYFIN_LOGIN_TIMEOUT=10

# --- storage / behaviour --------------------------------------------------------

#PROXY_DB_PATH=./data/proxy.db
#LIKED_TRACKS_DIR=/mnt/Main/Apps/music_files
#TIDAL_DOWNLOAD_QUALITY=LOSSLESS
#PROXY_TOKEN_TTL_DAYS=30

# --- rate limiting ------------------------------------------------------------

#PROXY_LOGIN_MAX_FAILURES=8
#PROXY_LOGIN_LOCKOUT_SECONDS=300
#TRUSTED_PROXY_IPS=127.0.0.1,::1
